   "[[\"p\",[[\"normal\",\"The five-variable law of the Marton data with the two receivers exchanged — the two auxiliary\"],[\"softbr\",\"\\n\"],[\"normal\",\"letters of \"],[\"code\",[\"pV\"]],[\"normal\",\" and \"],[\"code\",[\"K\"]],[\"normal\",\" and the two outputs of \"],[\"code\",[\"W\"]],[\"normal\",\" traded — is the pushforward of the original law\"],[\"softbr\",\"\\n\"],[\"normal\",\"along the map that trades the two auxiliary letters and the two outputs.\"]]],[\"p\",[[\"normal\",\"@audit:ok\"]]]]"),
