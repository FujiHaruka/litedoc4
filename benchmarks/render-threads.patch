+    } else {
+        thread::scope(|scope| {
+            #[expect(
+                clippy::needless_collect,
+                reason = "dropping it makes spawn lazy: every worker would be joined before the next is spawned, which is the sequential run"
+            )]
+            let handles: Vec<_> = targets
+                .chunks(per_worker)
+                .map(|slice| {
+                    scope.spawn(|| {
+                        render_chunk(slice, options, source_url, &index, &suppressed, &site)
+                    })
+                })
+                .collect();
+            handles
+                .into_iter()
+                .map(|handle| handle.join().expect("a render worker panicked"))
+                .collect()
+        })
+    };
+
+    for partial in partials {
+        let partial = partial?;
+        summary.pages_written += partial.pages_written;
