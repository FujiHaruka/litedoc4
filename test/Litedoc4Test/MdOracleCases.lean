   "[[\"p\",[[\"normal\",\"At a degenerate band the eigenvalue enumeration collapses to \"],[\"code\",[\"0\"]],[\"normal\",\", so the \"],[\"code\",[\"0 < W\"]],[\"normal\",\" hypothesis of\"],[\"softbr\",\"\\n\"],[\"code\",[\"prolateEigenvalues_zero_pos\"]],[\"normal\",\" cannot be relaxed to \"],[\"code\",[\"0 ≤ W\"]],[\"normal\",\".\"],[\"softbr\",\"\\n\"],[\"normal\",\"@audit:ok\"]]]]"),
