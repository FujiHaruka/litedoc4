itionally-complete \"],[\"code\",[\"ℝ\"]],[\"normal\",\", collapsing\"],[\"softbr\",\"\\n\"],[\"normal\",\"the capacity to \"],[\"code\",[\"0\"]],[\"normal\",\".\"]]],[\"p\",[[\"normal\",\"Hypotheses \"],[\"code\",[\"hW\"]],[\"normal\",\"/\"],[\"code\",[\"hN₀\"]],[\"normal\",\"/\"],[\"code\",[\"hP\"]],[\"normal\",\" are regularity-only (not load-bearing).\"]]],[\"p\",[[\"normal\",\"@audit:ok (sorryAx-free; signature scan regularity-only, no load-bearing hyp. The block\"],[\"softbr\",\"\\n\"],[\"code\",[\"awgn_channel_coding_theorem\"]],[\"normal\",\"'s only non-rate hypothesis \"],[\"code\",[\"h_meas\"]],[\"normal\",\" is discharged by the theorem\"],[\"softbr\",\"\\n\"],[\"code\",[\"AWGN.isAwgnChannelMeasurable N\"]],[\"normal\",\", not leaked into this signature; the load-bearing\"],[\"softbr\",\"\\n\"],[\"code\",[\"awgn_capacity_closed_form\"]],[\"normal\",\" (\"],[\"code\",[\"h_bridge_gauss\"]],[\"normal\",\"/\"],[\"code\",[\"h_bdd\"]],[\"normal\",\"/\"],[\"code\",[\"h_max_ent\"]],[\"normal\",\") is off-path — 0 transitive\"],[\"softbr\",\"\\n\"],[\"normal\",\"references from this headline.)\"]]]]"),
