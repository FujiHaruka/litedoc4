--- /dev/null
+++ b/Example/Interval.lean
@@ -0,0 +1,19 @@
+/-!
+# A closed interval of natural numbers
+
+A module that the previous version did not have.
+-/
+
+namespace Example
+
+/-- A closed interval `[lo, hi]`. -/
+structure Interval where
+  /-- The lower end. -/
+  lo : Nat
+  /-- The upper end. -/
+  hi : Nat
+
+/-- How far apart the two ends are. -/
+def Interval.width (i : Interval) : Nat := i.hi - i.lo
+
+end Example
