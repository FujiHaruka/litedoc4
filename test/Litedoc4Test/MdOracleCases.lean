alue or EPI content is bundled.\"],[\"softbr\",\"\\n\"],[\"normal\",\"Body: Gaussian convolution additivity (\"],[\"code\",[\"gaussianReal\"]],[\"normal\",\" add of the independent\"],[\"softbr\",\"\\n\"],[\"normal\",\"noise variances) + reassociation of the \"],[\"code\",[\"map\"]],[\"normal\",\".\"]]],[\"p\",[[\"normal\",\"The precondition is joint independence of \"],[\"code\",[\"X+Y\"]],[\"normal\",\" from the pair \"],[\"code\",[\"(Z_X, Z_Y)\"]],[\"softbr\",\"\\n\"],[\"normal\",\"(\"],[\"code\",[\"hXY_ZXZY_pair\"]],[\"normal\",\") rather than from the unscaled sum \"],[\"code\",[\"Z_X+Z_Y\"]],[\"normal\",\": the matched-sum\"],[\"softbr\",\"\\n\"],[\"normal\",\"noise is the \"],[\"em\",[[\"normal\",\"scaled\"]]],[\"normal\",\" combination \"],[\"code\",[\"√s_t·Z_X + √r_t·Z_Y\"]],[\"normal\",\" (a different linear\"],[\"softbr\",\"\\n\"],[\"normal\",\"functional from \"],[\"code\",[\"Z_X+Z_Y\"]],[\"normal\",\" when \"],[\"code\",[\"s_t ≠ r_t\"]],[\"normal\",\"), and its independence from \"],[\"code\",[\"X+Y\"]],[\"softbr\",\"\\n\"],[\"normal\",\"is recovered by \"],[\"code\",[\"IndepFun.comp\"]],[\"normal\",\" with the measurable map\"],[\"softbr\",\"\\n\"],[\"code\",[\"(z₁, z₂) ↦ √s_t·z₁ + √r_t·z₂\"]],[\"normal\",\". This is a regularity precondition, not a\"],[\"softbr\",\"\\n\"],[\"normal\",\"bundling of the conclusion.\"]]],[\"p\",[[\"normal\",\"Closed via \"],[\"code\",[\"gaussianReal_map_const_mul\"]],[\"normal\",\" (scaled-noise law \"],[\"code\",[\"√c·W ∼ 𝒩(0,c)\"]],[\"normal\",\"),\"],[\"softbr\",\"\\n\"],[\"code\",[\"gaussianReal_add_gaussianReal_of_indepFun\"]],[\"normal\",\" (LHS noise additivity), and\"],[\"softbr\",\"\\n\"],[\"code\",[\"IndepFun.map_add_eq_map_conv_map\"]],[\"normal\",\" (split both sides as\"],[\"softbr\",\"\\n\"],[\"code\",[\"(P.map (X+Y)) ∗ 𝒩(0, s_t+r_t)\"]],[\"normal\",\"). \"],[\"code\",[\"#print axioms\"]],[\"normal\",\" = sorryAx-free.\"]]]]"),
