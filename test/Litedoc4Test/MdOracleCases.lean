   "[[\"p\",[[\"normal\",\"A rate pair whose strictly-smaller (in both coordinates) perturbations are all\"],[\"softbr\",\"\\n\"],[\"normal\",\"achievable lies in the capacity region.  The perturbed points \"],[\"code\",[\"(p.1 - ε, p.2 - ε)\"]],[\"normal\",\" form a\"],[\"softbr\",\"\\n\"],[\"normal\",\"sequence in the achievable set converging to \"],[\"code\",[\"p\"]],[\"normal\",\", so \"],[\"code\",[\"p\"]],[\"normal\",\" is in its closure.\"],[\"softbr\",\"\\n\"],[\"normal\",\"@audit:ok\"]]]]"),
