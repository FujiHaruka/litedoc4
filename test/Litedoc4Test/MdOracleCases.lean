  ("InformationTheory.Shannon.convJointLlr_integrable", 8044,
   "Joint llr (conditional-KL divergence integrand) integrability, extracted from the\x0atemplate `h_int` block.  Given a probability space `μ` with coordinates `Z W`, a fiber\x0akernel `κ = condDistrib W Z μ` whose fibers a.e.-equal the (shifted) density `q(·−√s·z)`\x0aand whose marginal `μ.map W` has density `g`, with the polynomial majorant\x0a`|log g| ≤ (A+1)+B·x²`, the joint `llr` of the compProd vs. the product-with-const is\x0a`(μ.map Z) ⊗ₘ κ`-integrable.  All hypotheses are regularity/integrability\x0aobligations (none encodes the EPI conclusion).\x0a@audit:ok ",
   "[[\"p\",[[\"normal\",\"Joint llr (conditional-KL divergence integrand) integrability, extracted from the\"],[\"softbr\",\"\\n\"],[\"normal\",\"template \"],[\"code\",[\"h_int\"]],[\"normal\",\" block.  Given a probability space \"],[\"code\",[\"μ\"]],[\"normal\",\" with coordinates \"],[\"code\",[\"Z W\"]],[\"normal\",\", a fiber\"],[\"softbr\",\"\\n\"],[\"normal\",\"kernel \"],[\"code\",[\"κ = condDistrib W Z μ\"]],[\"normal\",\" whose fibers a.e.-equal the (shifted) density \"],[\"code\",[\"q(·−√s·z)\"]],[\"softbr\",\"\\n\"],[\"normal\",\"and whose marginal \"],[\"code\",[\"μ.map W\"]],[\"normal\",\" has density \"],[\"code\",[\"g\"]],[\"normal\",\", with the polynomial majorant\"],[\"softbr\",\"\\n\"],[\"code\",[\"|log g| ≤ (A+1)+B·x²\"]],[\"normal\",\", the joint \"],[\"code\",[\"llr\"]],[\"normal\",\" of the compProd vs. the product-with-const is\"],[\"softbr\",\"\\n\"],[\"code\",[\"(μ.map Z) ⊗ₘ κ\"]],[\"normal\",\"-integrable.  All hypotheses are regularity/integrability\"],[\"softbr\",\"\\n\"],[\"normal\",\"obligations (none encodes the EPI conclusion).\"],[\"softbr\",\"\\n\"],[\"normal\",\"@audit:ok\"]]]]"),
  ("InformationTheory.Shannon.affineShiftKernel", 8044,
