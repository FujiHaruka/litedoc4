rmal\",\" \"],[\"code\",[\"h_pos_stam\"]],[\"normal\",\" Fisher/Stam/Blachman bundle (ratio antitone side), the noise\"],[\"softbr\",\"\\n\"],[\"normal\",\"Gaussian laws + a.c. (\"],[\"code\",[\"hZX_law\"]],[\"normal\",\"/\"],[\"code\",[\"hZY_law\"]],[\"normal\",\"/\"],[\"code\",[\"hZXZY_indep\"]],[\"normal\",\"/\"],[\"code\",[\"hZX_ac\"]],[\"normal\",\"/\"],[\"code\",[\"hZY_ac\"]],[\"normal\",\"/\"],[\"code\",[\"hZXZY_ac\"]],[\"normal\",\"),\"],[\"softbr\",\"\\n\"],[\"normal\",\"the per-\"],[\"code\",[\"t\"]],[\"normal\",\" scaling regularity (\"],[\"code\",[\"h_scale_X/Y/sum\"]],[\"normal\",\"), and the per-path variance data +\"],[\"softbr\",\"\\n\"],[\"normal\",\"three \"],[\"code\",[\"IsRescaledPathRegular\"]],[\"normal\",\" bundles (§4 side). None is load-bearing: the EPI /\"],[\"softbr\",\"\\n\"],[\"normal\",\"Stam core is supplied inside the two pillars; the conclusion\"],[\"softbr\",\"\\n\"],[\"code\",[\"N(X+Y) ≥ N(X)+N(Y)\"]],[\"normal\",\" is not encoded in any hypothesis. The \"],[\"code\",[\"_of_regular\"]],[\"normal\",\" suffix\"],[\"softbr\",\"\\n\"],[\"normal\",\"records that those regularity preconditions are real and not removable here.\"]]],[\"p\",[[\"normal\",\"@audit:ok\"],[\"softbr\",\"\\n\"],[\"normal\",\"@audit:superseded-by(entropyPowerExt_add_ge) Superseded by the\"],[\"softbr\",\"\\n\"],[\"normal\",\"unconditional EPI; the sole consumer \"],[\"code\",[\"entropyPower_add_ge_case1_of_methodX\"]],[\"normal\",\" is a dead leaf.\"],[\"softbr\",\"\\n\"],[\"normal\",\"Retained as proof-done. The two-time variant \"],[\"code\",[\"entropyPower_add_ge_case1_of_regular_twotime\"]],[\"normal\",\" is\"],[\"softbr\",\"\\n\"],[\"normal\",\"separate and live.\"]]]]"),
