normal\",\"Main statements\"]]],[\"ul\",true,\"*\",[[false,null,null,[[\"p\",[[\"code\",[\"heatKernel_nonneg\"]],[\"normal\",\" / \"],[\"code\",[\"measurable_heatKernel\"]],[\"normal\",\" — basic regularity of the heat kernel.\"]]]]],[false,null,null,[[\"p\",[[\"code\",[\"deBruijn_identity_v2_of_heat_flow\"]],[\"normal\",\" — the de Bruijn identity from \"],[\"code\",[\"IsHeatFlowDensity\"]],[\"normal\",\" plus\"],[\"softbr\",\"\\n\"],[\"code\",[\"IsIBPHypothesis\"]],[\"normal\",\".\"]]]]]]],[\"header\",2,[[\"normal\",\"Implementation notes\"]]],[\"p\",[[\"normal\",\"The predicate split follows the Mathlib-shape rule: the heat-equation field matches the\"],[\"softbr\",\"\\n\"],[\"normal\",\"conclusion of the convolution chain rule, while the integration-by-parts field matches the\"],[\"softbr\",\"\\n\"],[\"normal\",\"conclusion expected by \"],[\"code\",[\"HasDerivAt.congr_of_eventuallyEq\"]],[\"normal\",\", so the two compose with\"],[\"softbr\",\"\\n\"],[\"code\",[\"deBruijn_identity_v2\"]],[\"normal\",\" without bridging lemmas.\"]]]]"),
