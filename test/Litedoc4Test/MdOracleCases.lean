[false,null,null,[[\"p\",[[\"code\",[\"hpX_ent\"]],[\"normal\",\" — \"],[\"code\",[\"negMulLog pX\"]],[\"normal\",\" is \"],[\"code\",[\"volume\"]],[\"normal\",\"-integrable, i.e. the input differential\"],[\"softbr\",\"\\n\"],[\"normal\",\"entropy \"],[\"code\",[\"h(X)\"]],[\"normal\",\" is finite (a regularity precondition on the input distribution,\"],[\"softbr\",\"\\n\"],[\"normal\",\"not derivable from L¹ + second moment).\"]]]]]]],[\"p\",[[\"normal\",\"Every field is a precondition (regularity / input-distribution data); none is a\"],[\"softbr\",\"\\n\"],[\"normal\",\"continuity / L¹-convergence / density-identification conclusion. This is not a\"],[\"softbr\",\"\\n\"],[\"normal\",\"load-bearing hypothesis bundle — the analytic content is discharged genuinely by\"],[\"softbr\",\"\\n\"],[\"code\",[\"heatFlowDifferentialEntropy_continuousWithinAt_zero\"]],[\"normal\",\", which only consumes these\"],[\"softbr\",\"\\n\"],[\"normal\",\"fields as inputs.\"]]]]"),
