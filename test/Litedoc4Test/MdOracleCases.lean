e \"],[\"code\",[\"ENNReal.ofReal P = 0\"]],[\"normal\",\"), yet\"],[\"softbr\",\"\\n\"],[\"code\",[\"∑ P'ᵢ ≤ P < 0\"]],[\"normal\",\" with \"],[\"code\",[\"P'ᵢ ≥ 0\"]],[\"normal\",\" is unsatisfiable, so the statement would be false there. The\"],[\"softbr\",\"\\n\"],[\"normal\",\"constraint is threaded from the headline \"],[\"code\",[\"parallel_gaussian_capacity_formula_minimal\"]],[\"normal\",\".\"]]]]"),
