   "[[\"p\",[[\"normal\",\"Membership of the shrunk rate point when user 2 is silent (\"],[\"code\",[\"R₂ = 0\"]],[\"normal\",\"): the analogue of\"],[\"softbr\",\"\\n\"],[\"code\",[\"mac_converse_rate_mul_one_sub_errorProb_mem_of_ceil_exp_le\"]],[\"normal\",\" for the point\"],[\"softbr\",\"\\n\"],[\"code\",[\"(R₁(1−Pe) − log2/n, 0)\"]],[\"normal\",\", which uses only the user-1 Fano bound\"],[\"softbr\",\"\\n\"],[\"normal\",\"(\"],[\"code\",[\"mac_converse_from_code_bound₁\"]],[\"normal\",\", needing just \"],[\"code\",[\"2 ≤ M₁\"]],[\"normal\",\") plus per-letter nonnegativity, so it\"],[\"softbr\",\"\\n\"],[\"normal\",\"survives the \"],[\"code\",[\"M₂ = 1\"]],[\"normal\",\" degeneracy.\"]]]]"),
  ("InformationTheory.Shannon.MAC.mac_timesharing_converse_interior", 8044,
