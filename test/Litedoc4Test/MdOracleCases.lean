   "[[\"header\",1,[[\"normal\",\"EPI lift-and-transport: 3-noise lift machinery\"]]],[\"p\",[[\"normal\",\"The 3-noise lift space \"],[\"code\",[\"Ω × ℝ × ℝ × ℝ\"]],[\"normal\",\" (three independent standard Gaussian factors)\"],[\"softbr\",\"\\n\"],[\"normal\",\"and the transport lemma that reduces a lift-space EPI conclusion to a base-space one.\"]]],[\"header\",2,[[\"normal\",\"Main definitions\"]]],[\"ul\",true,\"-\",[[false,null,null,[[\"p\",[[\"code\",[\"liftMeasure3\"]],[\"normal\",\": the product measure on \"],[\"code\",[\"Ω × ℝ × ℝ × ℝ\"]],[\"normal\",\".\"]]]]]]],[\"header\",2,[[\"normal\",\"Main statements\"]]],[\"ul\",true,\"-\",[[false,null,null,[[\"p\",[[\"code\",[\"entropyPower_map_comp_fst_eq3\"]],[\"normal\",\": \"],[\"code\",[\"entropyPower\"]],[\"normal\",\" is preserved by the first-factor projection.\"]]]]],[false,null,null,[[\"p\",[[\"code\",[\"entropy_power_inequality_via_lift3\"]],[\"normal\",\": reduces a lift-space EPI to the base-space EPI.\"]]]]]]]]"),
