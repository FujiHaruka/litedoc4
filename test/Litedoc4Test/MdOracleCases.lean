r\",\"\\n\"],[\"code\",[\"λ = 0, 1\"]],[\"normal\",\" handled in separate branches.\"]]],[\"header\",2,[[\"normal\",\"References\"]]],[\"ul\",true,\"*\",[[false,null,null,[[\"p\",[[\"normal\",\"T. M. Cover and J. A. Thomas, \"],[\"em\",[[\"normal\",\"Elements of Information Theory\"]]],[\"normal\",\" (2nd ed.), Wiley, 2006. Theorem 10.4.\"]]]]]]]]"),
