code\",[\"a : Fin n → ℝ\"]],[\"normal\",\" at the grid \"],[\"code\",[\"t_i = i·(T/n)\"]],[\"normal\",\"; it is how the band-limited codewords of a\"],[\"softbr\",\"\\n\"],[\"code\",[\"ContAwgnCode\"]],[\"normal\",\" get built from a discrete \"],[\"code\",[\"awgn_achievability\"]],[\"normal\",\" codebook. Its three properties power\"],[\"softbr\",\"\\n\"],[\"normal\",\"the reduction:\"]]],[\"ul\",true,\"*\",[[false,null,null,[[\"p\",[[\"normal\",\"interpolation exactness — \"],[\"code\",[\"synthSignal T n a (j·(T/n)) = a j\"]],[\"softbr\",\"\\n\"],[\"normal\",\"(\"],[\"code\",[\"synthSignal_sample\"]],[\"normal\",\").\"]]]]],[false,null,null,[[\"p\",[[\"normal\",\"band-limitedness — \"],[\"code\",[\"IsBandlimited (synthSignal T n a) W\"]],[\"normal\",\" when \"],[\"code\",[\"n ≤ 2WT\"]],[\"softbr\",\"\\n\"],[\"normal\",\"(\"],[\"code\",[\"synthSignal_bandlimited\"]],[\"normal\",\"): each shifted \"],[\"code\",[\"sincN(·/Δ)\"]],[\"normal\",\" has spectrum supported in\"],[\"softbr\",\"\\n\"],[\"code\",[\"[-1/(2Δ), 1/(2Δ)] = [-n/(2T), n/(2T)] ⊆ [-W, W]\"]],[\"normal\",\".\"]]]]],[false,null,null,[[\"p\",[[\"normal\",\"Parseval energy — \"],[\"code\",[\"∫ t, (synthSignal T n a t)² = (T/n)·∑ᵢ (a i)²\"]],[\"softbr\",\"\\n\"],[\"normal\",\"(\"],[\"code\",[\"synthSignal_energy\"]],[\"normal\",\"), an equality on the \"],[\"em\",[[\"normal\",\"whole line\"]]],[\"normal\",\", which is exactly the shape\"],[\"softbr\",\"\\n\"],[\"code\",[\"ContAwgnCode.encoder_power\"]],[\"normal\",\" asks for: with \"],[\"code\",[\"a = √(n/T)·c\"]],[\"normal\",\" it reads \"],[\"code\",[\"∑ᵢ cᵢ² ≤ T·P\"]],[\"normal\",\".\"]]]]]]],[\"header\",2,[[\"normal\",\"References\"]]],[\"ul\",true,\"*\",[[false,null,null,[[\"p\",[[\"normal\",\"T. M. Cover and J. A. Thomas, \"],[\"em\",[[\"normal\",\"Elements of Information Theory\"]]],[\"normal\",\" (2nd ed.), Wiley, 2006.\"],[\"softbr\",\"\\n\"],[\"normal\",\"Theorem 9.6.1 (achievability).\"]]]]]]]]"),
