  ("InformationTheory.Shannon.ziv_aseventual_le_blockLogAvg₂", 8044,
   "The a.s.-eventual Ziv comparison: the limsup of the greedy bit-rate is at\x0amost the limsup of `blockLogAvg₂`.\x0a\x0aThe achievability crux (Cover–Thomas Lemma 13.5.5): combining the Ziv product\x0abound `c·log c ≤ 8·log(|α|+1)·n` with the length-grouping overhead control\x0a`c = O(n/log n)` and the `-log Pₙ = n·blockLogAvg` identity, the greedy\x0abit-rate is asymptotically dominated by `blockLogAvg₂`. Stated as an\x0a`a.s.-eventual` limsup comparison (the per-block form is FALSE, counterexample\x0a`a^16`).\x0a\x0aThe Ziv→AEP connection is supplied by the composition\x0a`ziv_achievability_composition` (`c·log c ≤ negLogQk + o(n)`) plus the AEP\x0a`negLogQk_div_tendsto_condEntropyTail`, assembled in\x0a`ziv_aseventual_le_condEntropyTail_bits`.\x0a\x0a@audit:ok (non-circular, non-bundled (signature is `(μ, p)` +\x0a`[IsProbabilityMeasure μ]` regularity only), non-degenerate, sufficiency\x0aTRUE-as-framed (Cover–Thomas 13.5.5; per-block form correctly avoided;\x0adegenerate `entropyRate = 0` boundary stays alive)). ",
   "[[\"p\",[[\"normal\",\"The a.s.-eventual Ziv comparison: the limsup of the greedy bit-rate is at\"],[\"softbr\",\"\\n\"],[\"normal\",\"most the limsup of \"],[\"code\",[\"blockLogAvg₂\"]],[\"normal\",\".\"]]],[\"p\",[[\"normal\",\"The achievability crux (Cover–Thomas Lemma 13.5.5): combining the Ziv product\"],[\"softbr\",\"\\n\"],[\"normal\",\"bound \"],[\"code\",[\"c·log c ≤ 8·log(|α|+1)·n\"]],[\"normal\",\" with the length-grouping overhead control\"],[\"softbr\",\"\\n\"],[\"code\",[\"c = O(n/log n)\"]],[\"normal\",\" and the \"],[\"code\",[\"-log Pₙ = n·blockLogAvg\"]],[\"normal\",\" identity, the greedy\"],[\"softbr\",\"\\n\"],[\"normal\",\"bit-rate is asymptotically dominated by \"],[\"code\",[\"blockLogAvg₂\"]],[\"normal\",\". Stated as an\"],[\"softbr\",\"\\n\"],[\"code\",[\"a.s.-eventual\"]],[\"normal\",\" limsup comparison (the per-block form is FALSE, counterexample\"],[\"softbr\",\"\\n\"],[\"code\",[\"a^16\"]],[\"normal\",\").\"]]],[\"p\",[[\"normal\",\"The Ziv→AEP connection is supplied by the composition\"],[\"softbr\",\"\\n\"],[\"code\",[\"ziv_achievability_composition\"]],[\"normal\",\" (\"],[\"code\",[\"c·log c ≤ negLogQk + o(n)\"]],[\"normal\",\") plus the AEP\"],[\"softbr\",\"\\n\"],[\"code\",[\"negLogQk_div_tendsto_condEntropyTail\"]],[\"normal\",\", assembled in\"],[\"softbr\",\"\\n\"],[\"code\",[\"ziv_aseventual_le_condEntropyTail_bits\"]],[\"normal\",\".\"]]],[\"p\",[[\"normal\",\"@audit:ok (non-circular, non-bundled (signature is \"],[\"code\",[\"(μ, p)\"]],[\"normal\",\" +\"],[\"softbr\",\"\\n\"],[\"code\",[\"[IsProbabilityMeasure μ]\"]],[\"normal\",\" regularity only), non-degenerate, sufficiency\"],[\"softbr\",\"\\n\"],[\"normal\",\"TRUE-as-framed (Cover–Thomas 13.5.5; per-block form correctly avoided;\"],[\"softbr\",\"\\n\"],[\"normal\",\"degenerate \"],[\"code\",[\"entropyRate = 0\"]],[\"normal\",\" boundary stays alive)).\"]]]]"),
  ("InformationTheory.Shannon.factorial_two_pow_le_succ_pow", 8044,
